X86_64 IA64_AMD64_locked_zero
(* SPDX-License-Identifier: GPL-2.0-or-later *)
{
  x=0; y=0; scratch0=0; scratch1=0;
}
 P0                      | P1                      ;
 movl $1,(x)             | movl $1,(y)             ;
 lock addb $0,(scratch0) | lock addb $0,(scratch1) ;
 movl (y),%eax           | movl (x),%eax           ;
exists (0:rax=0 /\ 1:rax=0)
